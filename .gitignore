# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environments (uv creates .venv) -------------------------------
.venv/
venv/
env/

# --- Tooling caches --------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Jupyter ---------------------------------------------------------------
.ipynb_checkpoints/

# --- Data & artifacts ------------------------------------------------------
# Raw data is small and versioned; generated files are not.
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep
reports/figures/*
!reports/figures/.gitkeep
# Charts shown in the README
!reports/figures/csr_lags_real_vs_pred_h1.png
!reports/figures/csr_lags_real_vs_pred_h3.png
reports/tables/*
!reports/tables/.gitkeep

# --- R (in case the .rda files are opened in R) ----------------------------
.Rhistory
.RData
.Rproj.user/

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Secrets ---------------------------------------------------------------
.env
